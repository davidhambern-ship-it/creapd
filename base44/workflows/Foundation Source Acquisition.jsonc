{
  "name": "Foundation Source Acquisition",
  "description": "Every 6 hours: scans for foundation works with status \"Source Needed\" and runs the automated LLM-powered discovery pipeline to find, evaluate, and approve sources. Calls acquireFoundationSource directly with mode=auto_acquire.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "interval",
      "cron_expression": null,
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": 6,
      "interval_unit": "hours",
      "interval_anchor": "2026-07-02T07:35:50.772000",
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "foundation_source_acquisition",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "acquireFoundationSource",
            "args": {
              "mode": "auto_acquire"
            }
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "acquireFoundationSource"
  }
}