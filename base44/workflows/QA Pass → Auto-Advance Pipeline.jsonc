{
  "name": "QA Pass \u2192 Auto-Advance Pipeline",
  "description": "When a QualityReport's status is updated to 'pass' by the Controller, checks if all ResearchPoints for the topic have QA-passed packages. If so, triggers packet assembly via rppAutoAdvance.",
  "trigger": {
    "condition": "${ ((.trigger.changed_fields | index(\"status\") != null) and (.trigger.data.status == \"pass\")) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "QualityReport"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "qa_pass_auto_advance_pipeline",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "onQualityReportPass",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "onQualityReportPass"
  }
}