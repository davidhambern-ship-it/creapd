{
  "name": "AIServiceAccount",
  "type": "object",
  "properties": {
    "provider_name": {
      "type": "string"
    },
    "provider_category": {
      "type": "string",
      "enum": [
        "text",
        "image",
        "video",
        "audio",
        "speech_synthesis",
        "speech_recognition",
        "translation",
        "transcription",
        "data_analysis",
        "research"
      ],
      "default": "text"
    },
    "provider_label": {
      "type": "string"
    },
    "is_connected": {
      "type": "boolean",
      "default": false
    },
    "is_default": {
      "type": "boolean",
      "default": false
    },
    "connection_notes": {
      "type": "string"
    }
  },
  "required": [
    "provider_name",
    "provider_category"
  ]
}