{
  "name": "ProductionPacket",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string",
      "description": "ID of the ResearchProject this packet belongs to"
    },
    "name": {
      "type": "string",
      "description": "Packet name"
    },
    "description": {
      "type": "string",
      "description": "Packet description"
    },
    "included_assets": {
      "type": "string",
      "description": "JSON array of included ProductionAsset IDs and types"
    },
    "dossier_id": {
      "type": "string",
      "description": "ID of the approved ResearchDossier included in the packet"
    },
    "producer_notes": {
      "type": "string",
      "description": "Producer's notes on the final packet"
    },
    "quality_check_status": {
      "type": "string",
      "enum": [
        "pending",
        "passed",
        "needs_revision"
      ],
      "default": "pending"
    },
    "quality_check_notes": {
      "type": "string",
      "description": "Notes from quality check review"
    },
    "status": {
      "type": "string",
      "enum": [
        "assembling",
        "ready",
        "exported",
        "archived"
      ],
      "default": "assembling"
    }
  },
  "required": [
    "project_id",
    "name"
  ]
}