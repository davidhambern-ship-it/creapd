{
  "name": "SMCProviderAccount",
  "type": "object",
  "properties": {
    "source_id": {
      "type": "string",
      "description": "ID of the associated SMCSource"
    },
    "provider_name": {
      "type": "string"
    },
    "organization": {
      "type": "string"
    },
    "account_label": {
      "type": "string",
      "description": "Label (Production, Development, Testing, Archive)"
    },
    "account_status": {
      "type": "string",
      "enum": [
        "Connected",
        "Disconnected",
        "Error",
        "Expired",
        "Revoked",
        "Pending"
      ],
      "default": "Pending"
    },
    "authentication_type": {
      "type": "string",
      "enum": [
        "API Key",
        "OAuth 2.0",
        "Bearer Token",
        "Basic Auth",
        "JWT",
        "Service Account",
        "Client ID/Secret",
        "Anonymous",
        "Custom"
      ],
      "default": "API Key"
    },
    "credential_id": {
      "type": "string",
      "description": "ID of the associated SMCCredential"
    },
    "last_verified": {
      "type": "string",
      "format": "date-time"
    },
    "seeder_enabled": {
      "type": "boolean",
      "default": false
    },
    "cae_enabled": {
      "type": "boolean",
      "default": false
    },
    "research_enabled": {
      "type": "boolean",
      "default": false
    },
    "library_enabled": {
      "type": "boolean",
      "default": false
    },
    "permission_profile": {
      "type": "string",
      "description": "JSON object of permissions (read, metadata, bulk_download, search, import, publish, admin)"
    },
    "permission_summary": {
      "type": "string",
      "description": "Human-readable permission summary"
    },
    "rate_limit_remaining": {
      "type": "number",
      "default": 0
    },
    "rate_limit_total": {
      "type": "number",
      "default": 0
    },
    "rate_limit_reset": {
      "type": "string",
      "format": "date-time"
    },
    "usage_stats": {
      "type": "string",
      "description": "JSON object of usage stats (api_calls, success_count, fail_count, avg_response_time)"
    },
    "daily_usage": {
      "type": "number",
      "default": 0
    },
    "monthly_usage": {
      "type": "number",
      "default": 0
    },
    "connection_logs": {
      "type": "string",
      "description": "JSON array of connection log entries"
    },
    "admin_notes": {
      "type": "string"
    }
  },
  "required": [
    "provider_name",
    "account_label"
  ]
}