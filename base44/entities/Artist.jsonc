{
  "name": "Artist",
  "type": "object",
  "properties": {
    "artist_name": {
      "type": "string"
    },
    "genre": {
      "type": "string"
    },
    "biography": {
      "type": "string"
    },
    "discography": {
      "type": "string"
    },
    "awards": {
      "type": "string"
    },
    "interesting_facts": {
      "type": "string"
    },
    "birthday": {
      "type": "string",
      "format": "date"
    },
    "upcoming_tours": {
      "type": "string"
    },
    "social_links": {
      "type": "string"
    },
    "latest_news": {
      "type": "string"
    },
    "image_url": {
      "type": "string"
    },
    "producer_notes": {
      "type": "string"
    },
    "is_favorite": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "artist_name"
  ]
}