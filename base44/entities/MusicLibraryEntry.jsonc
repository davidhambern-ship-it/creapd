{
  "name": "MusicLibraryEntry",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Song title"
    },
    "artist": {
      "type": "string",
      "description": "Artist / performer name"
    },
    "album": {
      "type": "string",
      "description": "Album name"
    },
    "genre": {
      "type": "string",
      "description": "Primary genre"
    },
    "subgenre": {
      "type": "string"
    },
    "release_date": {
      "type": "string",
      "description": "Release date (ISO or year)"
    },
    "duration_seconds": {
      "type": "number",
      "description": "Duration in seconds"
    },
    "bpm": {
      "type": "number",
      "description": "Beats per minute"
    },
    "musical_key": {
      "type": "string",
      "description": "Musical key (e.g. C Major, A Minor)"
    },
    "mood": {
      "type": "string"
    },
    "language": {
      "type": "string"
    },
    "explicit_content": {
      "type": "boolean",
      "default": false
    },
    "composer": {
      "type": "string"
    },
    "producer": {
      "type": "string",
      "description": "Producer credits"
    },
    "label": {
      "type": "string"
    },
    "isrc": {
      "type": "string",
      "description": "International Standard Recording Code"
    },
    "provider": {
      "type": "string",
      "description": "Provider name that supplied this asset"
    },
    "provider_asset_id": {
      "type": "string",
      "description": "Provider-native identifier"
    },
    "source_url": {
      "type": "string",
      "description": "Original source URL"
    },
    "artwork_url": {
      "type": "string",
      "description": "Album artwork URL"
    },
    "thumbnail_url": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "playback_allowed": {
      "type": "boolean",
      "default": false,
      "description": "Whether this asset may be played by the Native Music Playback Engine"
    },
    "preview_available": {
      "type": "boolean",
      "default": false
    },
    "streaming_available": {
      "type": "boolean",
      "default": false
    },
    "download_available": {
      "type": "boolean",
      "default": false
    },
    "offline_cache_allowed": {
      "type": "boolean",
      "default": false
    },
    "commercial_use_allowed": {
      "type": "boolean",
      "default": false
    },
    "modification_allowed": {
      "type": "boolean",
      "default": false
    },
    "redistribution_allowed": {
      "type": "boolean",
      "default": false
    },
    "attribution_required": {
      "type": "boolean",
      "default": false
    },
    "attribution_text": {
      "type": "string",
      "description": "Formatted attribution string"
    },
    "license_type": {
      "type": "string",
      "enum": [
        "public_domain",
        "creative_commons",
        "royalty_free",
        "official_free_access",
        "commercial_license",
        "premium_subscription",
        "restricted",
        "unknown"
      ],
      "default": "unknown"
    },
    "license_url": {
      "type": "string"
    },
    "playback_url": {
      "type": "string",
      "description": "URL for streaming playback (if licensed)"
    },
    "preview_url": {
      "type": "string",
      "description": "Preview / sample audio URL"
    },
    "waveform_data": {
      "type": "string",
      "description": "JSON: waveform peak data for visualization (when available)"
    },
    "license_review_status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected",
        "requires_review"
      ],
      "default": "pending",
      "description": "KAAE licensing review status \u2014 only approved assets may be played"
    },
    "license_reviewed_at": {
      "type": "string",
      "format": "date-time"
    },
    "is_favorite": {
      "type": "boolean",
      "default": false
    },
    "collection_name": {
      "type": "string",
      "description": "Named collection this asset belongs to (optional)"
    },
    "usage_count": {
      "type": "number",
      "default": 0,
      "description": "How many times this asset has been used in production"
    },
    "last_used_at": {
      "type": "string",
      "format": "date-time"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "connector_id": {
      "type": "string",
      "description": "Which Connector discovered this asset"
    },
    "asset_category": {
      "type": "string",
      "enum": [
        "music_metadata",
        "playable_audio",
        "sound_effects"
      ],
      "description": "Whether this is metadata-only, playable audio, or a sound effect"
    }
  },
  "required": [
    "title",
    "artist"
  ]
}