{
  "name": "SpiritualMessageSection",
  "type": "object",
  "properties": {
    "configuration_id": {
      "type": "string",
      "description": "ID of the SpiritualProductionConfiguration"
    },
    "order": {
      "type": "number",
      "default": 0
    },
    "section_type": {
      "type": "string",
      "enum": [
        "opening",
        "introduction",
        "main_section",
        "supporting_reference",
        "illustration",
        "application",
        "discussion_question",
        "closing",
        "call_to_action",
        "prayer",
        "announcements",
        "closing_notes"
      ],
      "default": "main_section"
    },
    "title": {
      "type": "string"
    },
    "content": {
      "type": "string",
      "description": "Narration script for this scene \u2014 the spoken text"
    },
    "speaker_notes": {
      "type": "string",
      "description": "Private speaker notes"
    },
    "scripture_references": {
      "type": "string",
      "description": "Scripture/sacred text references with citations"
    },
    "citations": {
      "type": "string",
      "description": "Source citations for this section"
    },
    "estimated_duration_seconds": {
      "type": "number",
      "description": "Estimated speaking time in seconds"
    },
    "target_runtime_seconds": {
      "type": "number",
      "description": "Intended duration for this section based on total target runtime",
      "default": 0
    },
    "voice_url": {
      "type": "string",
      "description": "Generated voiceover audio URL"
    },
    "voice_duration_seconds": {
      "type": "number",
      "description": "Actual voiceover duration in seconds",
      "default": 0
    },
    "voice_package_id": {
      "type": "string",
      "description": "ID of the VoicePackage (VP) \u2014 authoritative narration timing source for this section"
    },
    "runtime_status": {
      "type": "string",
      "enum": [
        "pending",
        "on_target",
        "too_short",
        "too_long"
      ],
      "default": "pending"
    },
    "slide_title": {
      "type": "string",
      "description": "Title for the presentation slide"
    },
    "slide_content": {
      "type": "string",
      "description": "Bullet points or key phrases for the slide"
    },
    "slide_visual_prompt": {
      "type": "string",
      "description": "Detailed AI image generation prompt describing the visual scene"
    },
    "generated_image_url": {
      "type": "string",
      "description": "AI-generated image URL for this scene's slide background"
    },
    "transition": {
      "type": "string",
      "enum": [
        "fade",
        "slide_left",
        "zoom",
        "dissolve",
        "none"
      ],
      "default": "fade",
      "description": "Transition effect when advancing to this slide"
    },
    "scene_data": {
      "type": "string",
      "description": "JSON object with scripture_popups, graphics, and animation instructions"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "generated",
        "edited",
        "approved"
      ],
      "default": "draft"
    }
  },
  "required": [
    "configuration_id",
    "section_type"
  ]
}