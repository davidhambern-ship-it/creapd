{
  "name": "ProducerSettings",
  "type": "object",
  "properties": {
    "profile_name": {
      "type": "string",
      "default": "Berna"
    },
    "timezone": {
      "type": "string",
      "default": "America/New_York"
    },
    "brief_time": {
      "type": "string",
      "default": "06:00"
    },
    "active_days": {
      "type": "string",
      "default": "sun,mon,tue,wed,thu,fri"
    },
    "skip_saturday": {
      "type": "boolean",
      "default": true
    },
    "categories_enabled": {
      "type": "string"
    },
    "min_opportunity_score": {
      "type": "number",
      "default": 2
    },
    "block_recycled": {
      "type": "boolean",
      "default": true
    },
    "require_approval": {
      "type": "boolean",
      "default": false
    },
    "credibility_threshold": {
      "type": "number",
      "default": 3
    },
    "export_format": {
      "type": "string",
      "enum": [
        "pdf",
        "text",
        "markdown"
      ],
      "default": "pdf"
    },
    "echo_tone": {
      "type": "string",
      "enum": [
        "professional",
        "conversational",
        "energetic"
      ],
      "default": "professional"
    },
    "briefing_length": {
      "type": "string",
      "enum": [
        "short",
        "standard",
        "full"
      ],
      "default": "standard"
    },
    "notification_enabled": {
      "type": "boolean",
      "default": true
    },
    "onboarding_complete": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "profile_name"
  ]
}