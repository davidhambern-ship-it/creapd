{
  "name": "MusicResearchItem",
  "type": "object",
  "properties": {
    "configuration_id": {
      "type": "string",
      "description": "ID of the MusicProductionConfiguration this research belongs to"
    },
    "title": {
      "type": "string"
    },
    "source": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "url": {
      "type": "string",
      "description": "Source URL for the research item"
    },
    "suggested_angle": {
      "type": "string",
      "description": "Suggested coverage angle for the music show"
    },
    "date": {
      "type": "string"
    },
    "relevance": {
      "type": "string",
      "enum": [
        "high",
        "medium",
        "low"
      ],
      "default": "medium"
    },
    "added_to_rundown": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "configuration_id",
    "title"
  ]
}