{
  "name": "CookingProductionConfiguration",
  "type": "object",
  "properties": {
    "production_name": {
      "type": "string"
    },
    "host_name": {
      "type": "string"
    },
    "co_host_name": {
      "type": "string"
    },
    "show_date": {
      "type": "string",
      "format": "date"
    },
    "show_start_time": {
      "type": "string"
    },
    "live_or_recorded": {
      "type": "string",
      "enum": [
        "live",
        "recorded"
      ],
      "default": "live"
    },
    "station_name": {
      "type": "string"
    },
    "show_description": {
      "type": "string"
    },
    "show_format": {
      "type": "string",
      "enum": [
        "Step-by-Step Tutorial",
        "Quick Recipe",
        "Cooking Competition",
        "Ingredient Spotlight",
        "Cuisine Exploration",
        "Meal Prep Guide",
        "Baking Show",
        "Grilling & BBQ",
        "Healthy Cooking",
        "Comfort Food",
        "Holiday Special",
        "Batch Cooking",
        "One-Pot Meals",
        "Cooking with Kids",
        "Farm to Table",
        "Custom Format"
      ],
      "default": "Step-by-Step Tutorial"
    },
    "total_show_runtime": {
      "type": "number",
      "description": "Total show runtime in minutes",
      "default": 30
    },
    "cooking_segment_runtime": {
      "type": "number",
      "description": "Cooking/demo runtime in minutes",
      "default": 22
    },
    "commercial_sponsor_runtime": {
      "type": "number",
      "description": "Commercial/sponsor runtime in minutes",
      "default": 4
    },
    "intro_runtime": {
      "type": "number",
      "description": "Intro runtime in minutes",
      "default": 2
    },
    "outro_runtime": {
      "type": "number",
      "description": "Outro runtime in minutes",
      "default": 2
    },
    "cuisines": {
      "type": "string",
      "description": "JSON array of selected cuisines"
    },
    "research_sources": {
      "type": "string",
      "description": "JSON array of enabled research sources"
    },
    "show_tone": {
      "type": "string",
      "default": "Warm & Educational"
    },
    "guest_details": {
      "type": "string",
      "description": "Free-text guest chef information"
    },
    "ai_automation": {
      "type": "string",
      "description": "JSON array of selected AI automation options"
    },
    "vo_requirements": {
      "type": "string",
      "description": "JSON: { vo_enabled, auto_generate, silent_segments[], default_voice_id } \u2014 controls which segments get voiceovers for this production profile"
    },
    "status": {
      "type": "string",
      "enum": [
        "configuring",
        "building",
        "ready",
        "refreshing",
        "failed"
      ],
      "default": "configuring"
    },
    "is_default": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "production_name",
    "show_date"
  ]
}