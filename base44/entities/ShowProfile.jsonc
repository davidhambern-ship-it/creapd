{
  "name": "ShowProfile",
  "type": "object",
  "properties": {
    "show_name": {
      "type": "string"
    },
    "content_domain": {
      "type": "string",
      "description": "Legacy field \u2014 now derived from the active Production Module. Kept for backwards compatibility.",
      "default": "news"
    },
    "active_module_id": {
      "type": "string",
      "description": "ID of the currently active Production Module \u2014 determines the active production domain for this show"
    },
    "brand_profile_id": {
      "type": "string"
    },
    "host_names": {
      "type": "string"
    },
    "default_tone": {
      "type": "string",
      "enum": [
        "professional",
        "conversational",
        "energetic",
        "serious",
        "investigative",
        "educational",
        "inspirational",
        "neutral",
        "urgent",
        "humorous"
      ],
      "default": "professional"
    },
    "reading_style": {
      "type": "string",
      "enum": [
        "broadcast_news",
        "podcast",
        "livestream",
        "interview",
        "documentary",
        "educational_presentation",
        "corporate_communication",
        "storytelling"
      ],
      "default": "broadcast_news"
    },
    "audience": {
      "type": "string",
      "default": "General Public"
    },
    "target_runtime": {
      "type": "string",
      "default": "1 Minute"
    },
    "preferred_categories": {
      "type": "string"
    },
    "preferred_assets": {
      "type": "string"
    },
    "preferred_image_provider": {
      "type": "string",
      "enum": [
        "default",
        "dalle",
        "midjourney",
        "stable_diffusion",
        "custom"
      ],
      "default": "default"
    },
    "preferred_image_style": {
      "type": "string"
    },
    "default_ai_settings": {
      "type": "string"
    },
    "default_template_ids": {
      "type": "string"
    },
    "default_export_format": {
      "type": "string",
      "enum": [
        "pdf",
        "docx",
        "markdown",
        "html",
        "text"
      ],
      "default": "pdf"
    },
    "opening_script": {
      "type": "string"
    },
    "closing_script": {
      "type": "string"
    },
    "producer_notes": {
      "type": "string"
    },
    "is_favorite": {
      "type": "boolean",
      "default": false
    },
    "is_active": {
      "type": "boolean",
      "default": false,
      "description": "When true, this Show Profile is used by the backend for story filtering and scoring"
    },
    "preferred_topics": {
      "type": "string",
      "description": "JSON array of topics this show wants to cover (applies across all modules)"
    },
    "excluded_topics": {
      "type": "string",
      "description": "JSON array of topics this show does NOT want"
    },
    "region_local_focus": {
      "type": "string",
      "description": "Geographic region or local focus area (e.g. 'Midwest', 'Texas', 'Local NYC')"
    },
    "segment_structure": {
      "type": "string",
      "description": "Preferred segment structure (e.g. 'Lead Story, Quick Hits, Feature, Closing')"
    },
    "political_cultural_balance": {
      "type": "string",
      "enum": [
        "balanced",
        "lean_left",
        "lean_right",
        "neutral",
        "custom"
      ],
      "default": "balanced"
    },
    "preferred_sources": {
      "type": "string",
      "description": "JSON array of preferred source names"
    },
    "blocked_sources": {
      "type": "string",
      "description": "JSON array of blocked source names"
    },
    "story_priority_rules": {
      "type": "string",
      "description": "Free-text rules for prioritizing stories for this show"
    },
    "minimum_story_score": {
      "type": "number",
      "default": 5,
      "description": "Minimum show_fit_score (0-10) for an article to pass Show Profile filtering"
    },
    "content_types_allowed": {
      "type": "string",
      "description": "JSON array of allowed content types: text, video, audio, social",
      "default": "[\"text\",\"video\"]"
    },
    "allowed_categories": {
      "type": "string",
      "description": "JSON array of allowed article categories"
    },
    "rejected_categories": {
      "type": "string",
      "description": "JSON array of rejected article categories"
    },
    "freshness_window_hours": {
      "type": "number",
      "default": 48,
      "description": "Maximum age in hours for stories to be considered fresh for this show"
    },
    "controversy_tolerance": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "default": "medium"
    },
    "entertainment_level": {
      "type": "number",
      "default": 5,
      "description": "0-10 scale of how entertainment-focused the show is"
    },
    "educational_level": {
      "type": "number",
      "default": 5,
      "description": "0-10 scale of how educational the show is"
    },
    "focus_areas": {
      "type": "string",
      "description": "JSON array of focus areas: faith, family, business, community, etc."
    }
  },
  "required": [
    "show_name"
  ]
}