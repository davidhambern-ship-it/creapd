{
  "name": "ProductionPackage",
  "type": "object",
  "properties": {
    "article_id": {
      "type": "string"
    },
    "teleprompter_script": {
      "type": "string",
      "description": "News domain: broadcast-ready teleprompter script"
    },
    "show_script": {
      "type": "string",
      "description": "Radio domain: radio-ready host script for on-air delivery"
    },
    "story_summary": {
      "type": "string"
    },
    "talking_points": {
      "type": "string"
    },
    "lower_third_text": {
      "type": "string"
    },
    "headline_suggestions": {
      "type": "string"
    },
    "image_prompt": {
      "type": "string"
    },
    "thumbnail_prompt": {
      "type": "string"
    },
    "visual_suggestions": {
      "type": "string"
    },
    "broll_suggestions": {
      "type": "string",
      "description": "News domain: B-roll footage suggestions"
    },
    "social_caption": {
      "type": "string"
    },
    "fact_check_notes": {
      "type": "string",
      "description": "News domain: factual verification notes"
    },
    "artist_facts": {
      "type": "string",
      "description": "Radio domain: key facts about artists involved"
    },
    "playlist_segment": {
      "type": "string",
      "description": "Radio domain: suggested songs/tracks to pair with segment"
    },
    "cooking_notes": {
      "type": "string",
      "description": "Cooking domain: temperatures, times, technique tips"
    },
    "ingredient_list": {
      "type": "string",
      "description": "Cooking domain: ingredient list with quantities"
    },
    "scripture_references": {
      "type": "string",
      "description": "Spiritual domain: relevant scripture passages"
    },
    "reflection_notes": {
      "type": "string",
      "description": "Spiritual domain: discussion questions, prayer points"
    },
    "producer_notes": {
      "type": "string"
    },
    "estimated_runtime": {
      "type": "string"
    },
    "tone": {
      "type": "string",
      "enum": [
        "professional",
        "conversational",
        "energetic",
        "serious",
        "investigative",
        "educational",
        "inspirational",
        "neutral",
        "urgent",
        "humorous"
      ],
      "default": "professional"
    },
    "reading_style": {
      "type": "string",
      "enum": [
        "broadcast_news",
        "podcast",
        "livestream",
        "interview",
        "documentary",
        "educational_presentation",
        "corporate_communication",
        "storytelling"
      ],
      "default": "broadcast_news"
    },
    "audience": {
      "type": "string",
      "default": "General Public"
    },
    "target_runtime": {
      "type": "string",
      "default": "1 Minute"
    },
    "status": {
      "type": "string",
      "enum": [
        "not_generated",
        "generating",
        "generated",
        "edited",
        "approved"
      ],
      "default": "not_generated"
    },
    "generated_image_url": {
      "type": "string"
    },
    "generated_thumbnail_url": {
      "type": "string"
    },
    "generated_video_url": {
      "type": "string"
    },
    "generated_audio_url": {
      "type": "string"
    },
    "image_variations": {
      "type": "string"
    },
    "thumbnail_variations": {
      "type": "string"
    },
    "custom_prompt": {
      "type": "string"
    },
    "prompt_template_id": {
      "type": "string"
    },
    "generation_provider": {
      "type": "string"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "is_edited": {
      "type": "boolean",
      "default": false
    },
    "is_regenerated": {
      "type": "boolean",
      "default": false
    },
    "generation_count": {
      "type": "number",
      "default": 0
    },
    "translation_language": {
      "type": "string"
    },
    "translated_script": {
      "type": "string"
    },
    "translated_caption": {
      "type": "string"
    },
    "translated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "article_id"
  ]
}