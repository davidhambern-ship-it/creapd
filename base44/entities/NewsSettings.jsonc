{
  "name": "NewsSettings",
  "type": "object",
  "properties": {
    "profile_name": {
      "type": "string",
      "default": "Berna"
    },
    "timezone": {
      "type": "string",
      "default": "America/New_York"
    },
    "brief_time": {
      "type": "string",
      "default": "06:00"
    },
    "active_days": {
      "type": "string",
      "default": "sun,mon,tue,wed,thu,fri"
    },
    "skip_saturday": {
      "type": "boolean",
      "default": true
    },
    "categories_enabled": {
      "type": "string"
    },
    "min_opportunity_score": {
      "type": "number",
      "default": 2
    },
    "block_recycled": {
      "type": "boolean",
      "default": true
    },
    "require_approval": {
      "type": "boolean",
      "default": false
    },
    "credibility_threshold": {
      "type": "number",
      "default": 3
    },
    "export_format": {
      "type": "string",
      "enum": [
        "pdf",
        "docx",
        "markdown",
        "html",
        "text"
      ],
      "default": "pdf"
    },
    "echo_tone": {
      "type": "string",
      "enum": [
        "professional",
        "conversational",
        "energetic"
      ],
      "default": "professional"
    },
    "briefing_length": {
      "type": "string",
      "enum": [
        "short",
        "standard",
        "full"
      ],
      "default": "standard"
    },
    "notification_enabled": {
      "type": "boolean",
      "default": true
    },
    "onboarding_complete": {
      "type": "boolean",
      "default": false
    },
    "preferred_text_model": {
      "type": "string",
      "enum": [
        "automatic",
        "gpt_5_mini",
        "gemini_3_flash",
        "gpt_5_4",
        "gpt_5_5",
        "gemini_3_1_pro",
        "claude_sonnet_4_6",
        "claude_opus_4_6"
      ],
      "default": "automatic"
    },
    "preferred_image_provider": {
      "type": "string",
      "default": "default"
    },
    "preferred_video_provider": {
      "type": "string",
      "default": "default"
    },
    "preferred_audio_voice": {
      "type": "string",
      "default": "river"
    },
    "preferred_translation_language": {
      "type": "string",
      "default": "en"
    },
    "auto_fetch_stories": {
      "type": "boolean",
      "default": true,
      "description": "Automatically fetch stories from RSS feeds on schedule"
    },
    "auto_sift_content": {
      "type": "boolean",
      "default": true,
      "description": "Automatically classify articles as video or text after ingestion"
    },
    "auto_transcribe_videos": {
      "type": "boolean",
      "default": true,
      "description": "Automatically transcribe and summarize video articles"
    }
  },
  "required": [
    "profile_name"
  ]
}