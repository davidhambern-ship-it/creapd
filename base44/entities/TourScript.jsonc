{
  "name": "TourScript",
  "type": "object",
  "properties": {
    "route_path": {
      "type": "string",
      "description": "Route this tour plays on (e.g. '/home', '/queue')"
    },
    "script_name": {
      "type": "string",
      "description": "Display name for this tour script"
    },
    "description": {
      "type": "string"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "When false, the tour will not play on this route"
    },
    "default_voice": {
      "type": "string",
      "default": "storm",
      "description": "Default built-in TTS voice for all scenes in this script (river, honey, sunny, storm, spark)"
    },
    "default_elevenlabs_voice_id": {
      "type": "string",
      "description": "Default ElevenLabs voice ID for all scenes. When set, overrides default_voice."
    }
  },
  "required": [
    "route_path",
    "script_name"
  ]
}