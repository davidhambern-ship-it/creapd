{
  "name": "StoriesPresentation",
  "type": "object",
  "properties": {
    "pp_id": {
      "type": "string",
      "description": "Production Package unique identifier \u2014 shared by every asset in this PP"
    },
    "title": {
      "type": "string",
      "description": "Presentation title"
    },
    "project_id": {
      "type": "string",
      "description": "Associated project/production ID"
    },
    "production_profile": {
      "type": "string",
      "enum": [
        "news",
        "spiritual",
        "talk",
        "music",
        "sports",
        "cooking",
        "cosmo",
        "research"
      ],
      "description": "Which Production Profile this presentation was created with"
    },
    "packet_id": {
      "type": "string",
      "description": "ID of the source production packet"
    },
    "theme": {
      "type": "string",
      "description": "JSON: theme colors, fonts, spacing"
    },
    "aspect_ratio": {
      "type": "string",
      "enum": [
        "16:9",
        "4:3",
        "9:16",
        "1:1"
      ],
      "default": "16:9"
    },
    "slide_order": {
      "type": "string",
      "description": "JSON array of StorySlide IDs in presentation order"
    },
    "story_slide_ids": {
      "type": "string",
      "description": "Legacy: JSON array of StorySlide IDs"
    },
    "story_package_ids": {
      "type": "string",
      "description": "JSON array of source ProductionPackage IDs"
    },
    "master_timeline": {
      "type": "string",
      "description": "JSON: master presentation timeline"
    },
    "presentation_metadata": {
      "type": "string",
      "description": "JSON: title, runtime, story_count, etc."
    },
    "playback_settings": {
      "type": "string",
      "description": "JSON: resolution, aspect_ratio, frame_rate, etc."
    },
    "opening_sequence": {
      "type": "string",
      "description": "JSON: CREAPD branding, intro animation"
    },
    "closing_sequence": {
      "type": "string",
      "description": "JSON: closing branding, credits"
    },
    "presentation_version": {
      "type": "number",
      "default": 1,
      "description": "Version number \u2014 increments on Producer edits"
    },
    "version": {
      "type": "number",
      "default": 1,
      "description": "Editor version \u2014 tracks save iterations"
    },
    "status": {
      "type": "string",
      "enum": [
        "generating",
        "generated",
        "editing",
        "reviewing",
        "approved",
        "exported",
        "archived",
        "failed"
      ],
      "default": "generating"
    },
    "producer_id": {
      "type": "string",
      "description": "User ID of the Producer"
    },
    "producer_metadata": {
      "type": "string",
      "description": "JSON: review state, approval, lock status"
    },
    "export_metadata": {
      "type": "string",
      "description": "JSON: export format, status, history"
    },
    "qa_scores": {
      "type": "string",
      "description": "JSON: category scores (0-100 each)"
    },
    "confidence_score": {
      "type": "number",
      "default": 0,
      "description": "Production Confidence Score (0-100)"
    },
    "qa_result": {
      "type": "string",
      "enum": [
        "pass",
        "warning",
        "fail",
        "pending"
      ],
      "default": "pending"
    },
    "showcase_status": {
      "type": "string",
      "enum": [
        "none",
        "pending",
        "showcased",
        "removed"
      ],
      "default": "none"
    },
    "total_runtime_ms": {
      "type": "number",
      "default": 0
    },
    "story_count": {
      "type": "number",
      "default": 0
    },
    "generation_error": {
      "type": "string"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "title",
    "production_profile"
  ]
}