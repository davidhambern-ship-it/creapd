{
  "name": "PlaylistItem",
  "type": "object",
  "properties": {
    "configuration_id": {
      "type": "string",
      "description": "ID of the MusicProductionConfiguration this playlist belongs to"
    },
    "order": {
      "type": "number",
      "default": 0
    },
    "song_title": {
      "type": "string"
    },
    "artist": {
      "type": "string"
    },
    "length_seconds": {
      "type": "number",
      "description": "Song length in seconds"
    },
    "genre": {
      "type": "string"
    },
    "mood": {
      "type": "string"
    },
    "era_year": {
      "type": "string"
    },
    "album": {
      "type": "string"
    },
    "release_year": {
      "type": "string"
    },
    "reason_selected": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "suggested",
        "locked",
        "approved",
        "removed"
      ],
      "default": "suggested"
    },
    "note": {
      "type": "string"
    },
    "intro_generated": {
      "type": "boolean",
      "default": false
    },
    "artist_fact_generated": {
      "type": "boolean",
      "default": false
    },
    "spotify_track_id": {
      "type": "string",
      "description": "Spotify track ID for audio playback embed (22-char alphanumeric)"
    },
    "spotify_preview_url": {
      "type": "string",
      "description": "Spotify 30-second preview URL (if available)"
    },
    "album_art_url": {
      "type": "string",
      "description": "Album artwork URL from Spotify"
    },
    "youtube_video_id": {
      "type": "string",
      "description": "YouTube video ID \u2014 used only for user-selected manual tracks"
    },
    "thumbnail_url": {
      "type": "string",
      "description": "Thumbnail/album art URL"
    },
    "channel_name": {
      "type": "string",
      "description": "YouTube channel or label name"
    },
    "source": {
      "type": "string",
      "enum": [
        "ai_generated",
        "user_selected"
      ],
      "default": "ai_generated",
      "description": "Whether this track was AI-suggested or manually added by the user"
    }
  },
  "required": [
    "configuration_id",
    "song_title",
    "artist"
  ]
}