{
  "name": "RequirementItem",
  "type": "object",
  "properties": {
    "requirement_type": {
      "type": "string",
      "enum": [
        "functional",
        "non_functional",
        "acceptance"
      ],
      "default": "functional"
    },
    "category": {
      "type": "string"
    },
    "requirement_text": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "met",
        "in_progress",
        "not_met",
        "not_applicable"
      ],
      "default": "in_progress"
    },
    "notes": {
      "type": "string"
    },
    "sort_order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "requirement_type",
    "category",
    "requirement_text"
  ]
}