{
  "name": "SMCCredential",
  "type": "object",
  "properties": {
    "provider_account_id": {
      "type": "string",
      "description": "ID of associated SMCProviderAccount"
    },
    "provider_name": {
      "type": "string"
    },
    "credential_label": {
      "type": "string",
      "description": "Human-readable label"
    },
    "authentication_type": {
      "type": "string",
      "enum": [
        "API Key",
        "OAuth 2.0",
        "Bearer Token",
        "Basic Auth",
        "JWT",
        "Service Account",
        "Client ID/Secret",
        "Custom"
      ],
      "default": "API Key"
    },
    "encrypted_secret": {
      "type": "string",
      "description": "Encrypted credential value \u2014 never displayed after saving"
    },
    "secret_hint": {
      "type": "string",
      "description": "Last 4 chars or hint for identification"
    },
    "expiration_date": {
      "type": "string",
      "format": "date"
    },
    "rotation_schedule": {
      "type": "string",
      "enum": [
        "Never",
        "Monthly",
        "Quarterly",
        "Biannually",
        "Annually",
        "Custom"
      ],
      "default": "Annually"
    },
    "last_rotated": {
      "type": "string",
      "format": "date-time"
    },
    "last_used": {
      "type": "string",
      "format": "date-time"
    },
    "usage_count": {
      "type": "number",
      "default": 0
    },
    "status": {
      "type": "string",
      "enum": [
        "Healthy",
        "Expiring Soon",
        "Expired",
        "Authentication Failed",
        "Permission Changed",
        "Revoked",
        "Unknown"
      ],
      "default": "Unknown"
    },
    "admin_notes": {
      "type": "string"
    }
  },
  "required": [
    "provider_name",
    "credential_label",
    "authentication_type"
  ]
}