{
  "name": "CookingSegment",
  "type": "object",
  "properties": {
    "configuration_id": {
      "type": "string",
      "description": "ID of the CookingProductionConfiguration"
    },
    "order": {
      "type": "number",
      "default": 0
    },
    "segment_type": {
      "type": "string",
      "enum": [
        "intro",
        "host_monologue",
        "recipe_walkthrough",
        "technique_demo",
        "ingredient_spotlight",
        "tasting",
        "audience_qa",
        "sponsor_break",
        "station_id",
        "transition",
        "outro"
      ],
      "default": "recipe_walkthrough"
    },
    "title": {
      "type": "string"
    },
    "duration_seconds": {
      "type": "number",
      "default": 0
    },
    "start_time": {
      "type": "string",
      "description": "Start time HH:MM"
    },
    "end_time": {
      "type": "string",
      "description": "End time HH:MM"
    },
    "notes": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "ready",
        "approved"
      ],
      "default": "ready"
    }
  },
  "required": [
    "configuration_id",
    "segment_type"
  ]
}