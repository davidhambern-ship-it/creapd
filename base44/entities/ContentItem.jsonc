{
  "name": "ContentItem",
  "type": "object",
  "properties": {
    "production_id": {
      "type": "string"
    },
    "profile_id": {
      "type": "string"
    },
    "item_type": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "subtitle": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "source": {
      "type": "string"
    },
    "source_url": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "tags": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "researched",
        "selected",
        "in_rundown",
        "approved",
        "archived"
      ],
      "default": "researched"
    },
    "is_selected": {
      "type": "boolean",
      "default": false
    },
    "order": {
      "type": "number",
      "default": 0
    },
    "duration": {
      "type": "number"
    },
    "metadata": {
      "type": "string"
    },
    "generated_assets": {
      "type": "string"
    }
  },
  "required": [
    "production_id",
    "profile_id",
    "item_type",
    "title"
  ]
}