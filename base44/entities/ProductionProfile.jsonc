{
  "name": "ProductionProfile",
  "type": "object",
  "properties": {
    "profile_key": {
      "type": "string",
      "enum": [
        "news",
        "music",
        "radio",
        "podcast",
        "cooking",
        "sports",
        "talk",
        "livestream",
        "church",
        "educational",
        "business",
        "gaming",
        "custom"
      ]
    },
    "profile_name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "item_singular": {
      "type": "string"
    },
    "item_plural": {
      "type": "string"
    },
    "setup_fields": {
      "type": "string"
    },
    "dashboard_widgets": {
      "type": "string"
    },
    "sidebar_items": {
      "type": "string"
    },
    "research_modules": {
      "type": "string"
    },
    "content_item_types": {
      "type": "string"
    },
    "generated_assets": {
      "type": "string"
    },
    "export_options": {
      "type": "string"
    },
    "is_implemented": {
      "type": "boolean",
      "default": false
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "icon": {
      "type": "string"
    },
    "color": {
      "type": "string"
    }
  },
  "required": [
    "profile_key",
    "profile_name",
    "item_singular",
    "item_plural"
  ]
}