{
  "name": "ProductionProfile",
  "type": "object",
  "properties": {
    "profile_name": {
      "type": "string"
    },
    "profile_type": {
      "type": "string",
      "enum": [
        "news",
        "podcast",
        "radio_show",
        "music_show",
        "cooking_show",
        "sports_show",
        "talk_show",
        "livestream",
        "church_service",
        "educational_content",
        "business_briefing",
        "gaming_stream",
        "custom"
      ],
      "default": "news"
    },
    "description": {
      "type": "string"
    },
    "icon": {
      "type": "string"
    },
    "color": {
      "type": "string"
    },
    "research_modules": {
      "type": "string"
    },
    "production_modules": {
      "type": "string"
    },
    "output_modules": {
      "type": "string"
    },
    "default_templates": {
      "type": "string"
    },
    "ai_preferences": {
      "type": "string"
    },
    "export_settings": {
      "type": "string"
    },
    "item_type_label": {
      "type": "string",
      "default": "Item"
    },
    "item_type_label_plural": {
      "type": "string",
      "default": "Items"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "is_custom": {
      "type": "boolean",
      "default": false
    },
    "created_by_user_id": {
      "type": "string"
    },
    "sort_order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "profile_name",
    "profile_type",
    "description"
  ]
}