{
  "name": "TalkGuest",
  "type": "object",
  "properties": {
    "configuration_id": {
      "type": "string",
      "description": "ID of the TalkProductionConfiguration"
    },
    "guest_name": {
      "type": "string"
    },
    "title_role": {
      "type": "string",
      "description": "Guest title or role (e.g. Dr., Author, CEO)"
    },
    "bio": {
      "type": "string",
      "description": "Guest biography"
    },
    "talking_points": {
      "type": "string",
      "description": "Suggested talking points for this guest"
    },
    "photo_prompt": {
      "type": "string",
      "description": "AI image prompt for guest portrait"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "confirmed",
        "cancelled"
      ],
      "default": "pending"
    }
  },
  "required": [
    "configuration_id",
    "guest_name"
  ]
}