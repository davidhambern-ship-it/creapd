{
  "name": "ResearchProductionConfiguration",
  "type": "object",
  "properties": {
    "production_name": {
      "type": "string",
      "description": "Name of this research production session"
    },
    "host_name": {
      "type": "string",
      "description": "Name of the host/narrator"
    },
    "co_host_name": {
      "type": "string"
    },
    "show_date": {
      "type": "string",
      "format": "date"
    },
    "show_start_time": {
      "type": "string"
    },
    "live_or_recorded": {
      "type": "string",
      "enum": [
        "live",
        "recorded"
      ],
      "default": "recorded"
    },
    "station_name": {
      "type": "string"
    },
    "show_description": {
      "type": "string"
    },
    "total_show_runtime": {
      "type": "number",
      "description": "Total show runtime in minutes"
    },
    "research_depth": {
      "type": "string",
      "enum": [
        "quick_scan",
        "standard",
        "deep_dive",
        "exhaustive"
      ],
      "default": "standard",
      "description": "How deep the research should go"
    },
    "source_domains": {
      "type": "string",
      "description": "JSON array of source domains to search (academic, government, news, think_tank, etc.)"
    },
    "research_methodology": {
      "type": "string",
      "description": "JSON array of research methodologies (literature_review, expert_interview, data_analysis, etc.)"
    },
    "target_audience": {
      "type": "string",
      "default": "General Public"
    },
    "tone": {
      "type": "string",
      "enum": [
        "professional",
        "conversational",
        "energetic",
        "serious",
        "investigative",
        "educational",
        "inspirational",
        "neutral",
        "urgent",
        "humorous"
      ],
      "default": "educational"
    },
    "reading_style": {
      "type": "string",
      "enum": [
        "broadcast_news",
        "podcast",
        "livestream",
        "interview",
        "documentary",
        "educational_presentation",
        "corporate_communication",
        "storytelling"
      ],
      "default": "documentary"
    },
    "preferred_models": {
      "type": "string",
      "description": "JSON array of preferred AI models for synthesis"
    },
    "blocked_topics": {
      "type": "string",
      "description": "JSON array of topics to exclude"
    },
    "must_include": {
      "type": "string",
      "description": "JSON array of topics/sources that must be included"
    },
    "fact_check_required": {
      "type": "boolean",
      "default": true
    },
    "citation_required": {
      "type": "boolean",
      "default": true
    },
    "max_points_per_topic": {
      "type": "number",
      "default": 10,
      "description": "Maximum number of Point Cards to generate per research topic"
    },
    "vo_requirements": {
      "type": "string",
      "description": "JSON: { vo_enabled, auto_generate, silent_segments[], default_voice_id } \u2014 controls which segments get voiceovers for this production profile"
    },
    "status": {
      "type": "string",
      "enum": [
        "configuring",
        "researching",
        "ready",
        "refreshing",
        "failed"
      ],
      "default": "configuring"
    },
    "is_default": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "production_name",
    "show_date"
  ]
}