{
  "name": "SpiritualResearchItem",
  "type": "object",
  "properties": {
    "configuration_id": {
      "type": "string",
      "description": "ID of the SpiritualProductionConfiguration"
    },
    "title": {
      "type": "string"
    },
    "source": {
      "type": "string",
      "description": "Source name or publication"
    },
    "source_type": {
      "type": "string",
      "enum": [
        "primary_source",
        "secondary_source",
        "historical_reference",
        "language_study",
        "current_event",
        "ai_suggestion"
      ],
      "default": "secondary_source"
    },
    "category": {
      "type": "string"
    },
    "summary": {
      "type": "string",
      "description": "Full extracted summary of the research item"
    },
    "full_text": {
      "type": "string",
      "description": "Full article text when legally and technically available"
    },
    "excerpt": {
      "type": "string",
      "description": "Short representative excerpt from the source"
    },
    "key_points": {
      "type": "string",
      "description": "JSON array of key points extracted from the source"
    },
    "author": {
      "type": "string",
      "description": "Author or organization of the source"
    },
    "date": {
      "type": "string"
    },
    "publication_date": {
      "type": "string",
      "description": "Publication date of the source material"
    },
    "source_url": {
      "type": "string",
      "description": "URL to the original source"
    },
    "relevance": {
      "type": "string",
      "enum": [
        "high",
        "medium",
        "low"
      ],
      "default": "medium"
    },
    "citation": {
      "type": "string",
      "description": "Full citation information"
    },
    "associated_topic": {
      "type": "string"
    },
    "tags": {
      "type": "string",
      "description": "Comma-separated tags"
    },
    "related_topics": {
      "type": "string",
      "description": "JSON array of related topic strings"
    },
    "related_study_questions": {
      "type": "string",
      "description": "JSON array of related study question strings"
    },
    "notes": {
      "type": "string",
      "description": "Producer's personal notes on this research item"
    },
    "full_text_available": {
      "type": "boolean",
      "default": false,
      "description": "Whether full article text is available"
    },
    "full_text_unavailable_reason": {
      "type": "string",
      "description": "Reason full text is unavailable (paywall, removed, etc.)"
    },
    "added_to_study": {
      "type": "boolean",
      "default": false
    },
    "added_to_message": {
      "type": "boolean",
      "default": false
    },
    "added_to_package": {
      "type": "boolean",
      "default": false
    },
    "is_saved": {
      "type": "boolean",
      "default": false,
      "description": "Saved to research library"
    },
    "status": {
      "type": "string",
      "enum": [
        "new",
        "reviewed",
        "saved",
        "archived"
      ],
      "default": "new"
    }
  },
  "required": [
    "configuration_id",
    "title"
  ]
}