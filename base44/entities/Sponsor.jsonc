{
  "name": "Sponsor",
  "type": "object",
  "properties": {
    "sponsor_name": {
      "type": "string"
    },
    "contact_info": {
      "type": "string"
    },
    "commercial_script": {
      "type": "string"
    },
    "read_duration": {
      "type": "string",
      "default": "30 seconds"
    },
    "placement_preference": {
      "type": "string"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "start_date": {
      "type": "string",
      "format": "date"
    },
    "end_date": {
      "type": "string",
      "format": "date"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "sponsor_name"
  ]
}