{
  "name": "ResearchProject",
  "type": "object",
  "properties": {
    "production_name": {
      "type": "string",
      "description": "Name of the research production project"
    },
    "description": {
      "type": "string",
      "description": "Brief description of the project"
    },
    "status": {
      "type": "string",
      "enum": [
        "configuring",
        "researching",
        "dossier_pending",
        "developing",
        "packet_ready",
        "exported",
        "archived"
      ],
      "default": "configuring",
      "description": "Current stage in the production pipeline"
    },
    "research_question": {
      "type": "string",
      "description": "The main research question or topic the producer wants to investigate"
    },
    "intent_summary": {
      "type": "string",
      "description": "CREAPr's understanding of the producer's intent"
    },
    "categories": {
      "type": "string",
      "description": "JSON array of generated research category objects"
    },
    "active_department": {
      "type": "string",
      "default": "lobby",
      "description": "Which department the producer is currently working in"
    },
    "progress_research": {
      "type": "number",
      "default": 0,
      "description": "Research department progress 0-100"
    },
    "progress_dossier": {
      "type": "number",
      "default": 0,
      "description": "Dossier department progress 0-100"
    },
    "progress_develop": {
      "type": "number",
      "default": 0,
      "description": "Develop department progress 0-100"
    },
    "progress_packet": {
      "type": "number",
      "default": 0,
      "description": "Packet department progress 0-100"
    },
    "is_archived": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "production_name"
  ]
}