{
  "name": "Article",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "source_name": {
      "type": "string"
    },
    "author": {
      "type": "string"
    },
    "publication": {
      "type": "string"
    },
    "published_at": {
      "type": "string",
      "format": "date-time"
    },
    "url": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "full_text_excerpt": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "top_story",
        "politics",
        "world",
        "national",
        "state",
        "local",
        "business",
        "markets",
        "ai_business",
        "ai",
        "technology",
        "science",
        "health",
        "environment",
        "education",
        "entertainment",
        "sports",
        "weather",
        "crime_safety",
        "military",
        "food_agriculture",
        "small_business",
        "entrepreneurship",
        "skilled_trades",
        "hiring",
        "creator_economy",
        "good_news",
        "fact_check",
        "community",
        "opinion",
        "manufacturing",
        "reshoring",
        "supply_chain",
        "state_economy",
        "infrastructure",
        "general",
        "new_release",
        "tour_announcement",
        "artist_news",
        "chart_movement",
        "festival_lineup",
        "album_review",
        "interview",
        "music_industry",
        "streaming",
        "local_concert",
        "genre_spotlight",
        "classic_track"
      ]
    },
    "state": {
      "type": "string"
    },
    "industry": {
      "type": "string"
    },
    "companies": {
      "type": "string"
    },
    "people": {
      "type": "string"
    },
    "geographic_relevance": {
      "type": "string"
    },
    "why_it_matters": {
      "type": "string"
    },
    "estimated_reading_time": {
      "type": "string"
    },
    "tags": {
      "type": "string"
    },
    "priority_score": {
      "type": "number"
    },
    "key_facts": {
      "type": "string"
    },
    "timeline": {
      "type": "string"
    },
    "additional_sources": {
      "type": "string"
    },
    "is_saved": {
      "type": "boolean",
      "default": false
    },
    "freshness_score": {
      "type": "number"
    },
    "credibility_score": {
      "type": "number"
    },
    "opportunity_score": {
      "type": "number"
    },
    "usefulness_score": {
      "type": "number"
    },
    "duplicate_score": {
      "type": "number"
    },
    "duplicate_group_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected",
        "saved_for_later",
        "bernas_pick",
        "needs_research",
        "needs_review",
        "used",
        "available",
        "selected",
        "in_production",
        "package_generated",
        "edited",
        "ready_for_export",
        "archived"
      ],
      "default": "pending"
    },
    "rejection_reason": {
      "type": "string"
    },
    "thumbnail_url": {
      "type": "string"
    },
    "production_id": {
      "type": "string"
    },
    "production_priority": {
      "type": "string",
      "enum": [
        "breaking",
        "high",
        "standard",
        "feature",
        "optional",
        "archived"
      ],
      "default": "standard"
    },
    "production_status": {
      "type": "string",
      "enum": [
        "selected",
        "researching",
        "generating_package",
        "package_ready",
        "editing",
        "ready_for_review",
        "approved",
        "ready_for_export",
        "exported",
        "archived"
      ],
      "default": "selected"
    },
    "locked": {
      "type": "boolean",
      "default": false
    },
    "archived_date": {
      "type": "string",
      "format": "date-time",
      "description": "When the article entered the archive (used for 7-day auto-delete countdown on rejected articles)"
    },
    "content_type": {
      "type": "string",
      "enum": [
        "text",
        "video",
        "unknown"
      ],
      "default": "unknown",
      "description": "Whether the article is primarily video or text content (set by Content Sift Engine)"
    },
    "video_url": {
      "type": "string",
      "description": "Extracted direct video/audio URL for transcription"
    },
    "transcript": {
      "type": "string",
      "description": "Full transcript of video/audio content (if available)"
    },
    "transcription_status": {
      "type": "string",
      "enum": [
        "pending",
        "processing",
        "transcribed",
        "failed",
        "metadata_only",
        "not_applicable"
      ],
      "default": "pending",
      "description": "Status of video transcription processing. 'metadata_only' means AI summarized from title/description only \u2014 full video was not reviewed."
    },
    "suggested_angle": {
      "type": "string",
      "description": "AI-suggested coverage angle for this story"
    },
    "suggested_segment": {
      "type": "string",
      "enum": [
        "Lead Story",
        "Quick Hit",
        "Feature",
        "Breaking",
        "Talking Points",
        "Fact Check",
        "B-Roll Package"
      ],
      "description": "AI-suggested broadcast segment placement"
    },
    "source_quality_score": {
      "type": "number",
      "description": "Source reliability/authority score (0-10, set by AI review)"
    },
    "overall_story_score": {
      "type": "number",
      "description": "Overall story newsworthiness score (0-10, set by AI review)"
    },
    "safety_flags": {
      "type": "string",
      "description": "JSON array of safety flags (e.g. unverified_claim, sensitive_topic, potential_bias)"
    },
    "processing_history": {
      "type": "string",
      "description": "JSON array of {event, timestamp, details} tracking the article lifecycle"
    }
  },
  "required": [
    "title",
    "url"
  ]
}