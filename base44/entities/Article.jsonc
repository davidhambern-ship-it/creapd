{
  "name": "Article",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "source_name": {
      "type": "string"
    },
    "author": {
      "type": "string"
    },
    "publication": {
      "type": "string"
    },
    "published_at": {
      "type": "string",
      "format": "date-time"
    },
    "url": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "full_text_excerpt": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "top_story",
        "politics",
        "world",
        "national",
        "state",
        "local",
        "business",
        "markets",
        "ai_business",
        "ai",
        "technology",
        "science",
        "health",
        "environment",
        "education",
        "entertainment",
        "sports",
        "weather",
        "crime_safety",
        "military",
        "food_agriculture",
        "small_business",
        "entrepreneurship",
        "skilled_trades",
        "hiring",
        "creator_economy",
        "good_news",
        "fact_check",
        "community",
        "opinion",
        "manufacturing",
        "reshoring",
        "supply_chain",
        "state_economy",
        "infrastructure",
        "general"
      ]
    },
    "state": {
      "type": "string"
    },
    "industry": {
      "type": "string"
    },
    "companies": {
      "type": "string"
    },
    "people": {
      "type": "string"
    },
    "geographic_relevance": {
      "type": "string"
    },
    "why_it_matters": {
      "type": "string"
    },
    "estimated_reading_time": {
      "type": "string"
    },
    "tags": {
      "type": "string"
    },
    "priority_score": {
      "type": "number"
    },
    "key_facts": {
      "type": "string"
    },
    "timeline": {
      "type": "string"
    },
    "additional_sources": {
      "type": "string"
    },
    "is_saved": {
      "type": "boolean",
      "default": false
    },
    "freshness_score": {
      "type": "number"
    },
    "credibility_score": {
      "type": "number"
    },
    "opportunity_score": {
      "type": "number"
    },
    "usefulness_score": {
      "type": "number"
    },
    "duplicate_score": {
      "type": "number"
    },
    "duplicate_group_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected",
        "saved_for_later",
        "bernas_pick",
        "needs_research",
        "used",
        "available",
        "selected",
        "in_production",
        "package_generated",
        "edited",
        "ready_for_export",
        "archived"
      ],
      "default": "pending"
    },
    "rejection_reason": {
      "type": "string"
    },
    "thumbnail_url": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "url"
  ]
}