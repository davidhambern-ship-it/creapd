{
  "name": "ShowSegment",
  "type": "object",
  "properties": {
    "segment_type": {
      "type": "string",
      "enum": [
        "artist_spotlight",
        "throwback_moment",
        "on_this_day",
        "music_trivia",
        "birthday_spotlight",
        "album_review",
        "concert_calendar",
        "entertainment_headlines",
        "song_battle",
        "top_five_countdown",
        "listener_poll",
        "host_story",
        "sponsor_break",
        "weather",
        "traffic",
        "community_events",
        "station_id",
        "commercial_break",
        "host_intro",
        "closing"
      ]
    },
    "segment_title": {
      "type": "string"
    },
    "content": {
      "type": "string"
    },
    "duration": {
      "type": "string"
    },
    "order": {
      "type": "number",
      "default": 0
    },
    "production_id": {
      "type": "string"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "segment_type",
    "segment_title"
  ]
}