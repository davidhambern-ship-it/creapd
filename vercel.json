{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/creapd/talk/media.js": {
      "maxDuration": 120
    },
    "api/creapd/**/*.js": {
      "maxDuration": 60
    }
  },
  "routes": [
    {
      "handle": "filesystem"
    },
    {
      "src": "/api/(.*)",
      "dest": "https://creapd.base44.app/api/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
